{
  "name": "2026bdbv-dashboard",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bdbv/web",
    "dev:docs": "npm run dev -w @bdbv/docs",
    "build": "npm run build -w @bdbv/web",
    "build:docs": "npm run build -w @bdbv/docs",
    "test": "npm run test -w @bdbv/schema && cargo test --workspace --manifest-path Cargo.toml",
    "test:schema": "npm run test -w @bdbv/schema",
    "test:rust": "cargo test --workspace --manifest-path Cargo.toml",
    "build:wasm": "node scripts/build-surv-wasm.mjs",
    "verify": "bash scripts/verify.sh",
    "verify:scaffold": "bash scripts/verify.sh scaffold",
    "verify:schema": "bash scripts/verify.sh schema",
    "verify:engine": "bash scripts/verify.sh engine",
    "verify:curation": "bash scripts/verify.sh curation",
    "lint": "cargo fmt --all -- --check && cargo clippy --workspace -- -D warnings",
    "seed:neo4j": "node scripts/seed-neo4j.mjs",
    "seed:d1-curate": "node scripts/seed-d1-curate.mjs",
    "fetch:cod-ab": "node scripts/fetch-cod-ab-cd.mjs"
  }
}
