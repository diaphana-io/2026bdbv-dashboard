APP_ENV=staging
EXTRACT_ENABLED=false
# Production path on 2026bdbv.diaphana.io — leave empty for local dev
# APP_BASE_PATH=/app
# Cloudflare Access (set both in staging/production to enforce JWT on /curate)
# CF_ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
# CF_ACCESS_AUD=
# Neo4j — Aura (production) or local compose (see docs/neo4j-aura.md)
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
