APP_ENV=staging
EXTRACT_ENABLED=false
# Production path on 2026bdbv.diaphana.io — leave empty for local dev
# APP_BASE_PATH=/app
# Cloudflare Access (CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD): Worker secrets only —
# never commit values. See docs/security-deploy.md.
# Neo4j — Aura (production) or local compose (see docs/neo4j-aura.md)
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# (Workers normalize neo4j+s → bolt+s to skip routing discovery)
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# Aura Free: USER and DATABASE are often the instance id (e.g. 928c135c)
# NEO4J_DATABASE=
# NEO4J_PASSWORD=
# Hard Bolt ceiling (ms) so hung Aura cannot Error 1101 — see docs/neo4j-aura.md
# NEO4J_SESSION_TIMEOUT_MS=2500
# Isolate SWR cache TTL for graph reads (ms)
# NEO4J_READ_CACHE_TTL_MS=30000
